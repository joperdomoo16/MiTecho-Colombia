<?xml version="1.0" encoding="utf-8"?>
<!-- Toda la conexión de la app va cifrada: se bloquea el tráfico HTTP sin cifrar en todas las versiones de Android -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
