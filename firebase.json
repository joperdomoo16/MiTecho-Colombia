{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "android/**",
      "test/**",
      "tienda/**",
      "correos/**",
      "dist/**",
      "css/**",
      "js/**",
      "vistas/**",
      "index.html",
      "*.json",
      "*.md",
      "Preparardist.js",
      "assets/fuentes/**",
      "assets/proyectos/**",
      "assets/Logoglyphgrande.webp",
      "assets/Logoapp.webp",
      "MiTecho.apk",
      "supabase/**",
      "hojacalculo/**",
      "assets/tutorial/**",
      "**/*.gs",
      "*.apk"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
      {
        "source": "/Eliminarcuenta.html",
        "destination": "/Eliminarcuenta",
        "type": 301
      },
      {
        "source": "/Politicadeprivacidad.html",
        "destination": "/Politicadeprivacidad",
        "type": 301
      },
      {
        "source": "/Transparenciayprivacidad.html",
        "destination": "/Transparenciayprivacidad",
        "type": 301
      },
      {
        "source": "/sitiolegal/Eliminarcuenta.html",
        "destination": "/Eliminarcuenta",
        "type": 301
      },
      {
        "source": "/sitiolegal/Politicadeprivacidad.html",
        "destination": "/Politicadeprivacidad",
        "type": 301
      },
      {
        "source": "/sitiolegal/Transparenciayprivacidad.html",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/sitiolegal/Eliminarcuenta",
        "destination": "/Eliminarcuenta",
        "type": 301
      },
      {
        "source": "/sitiolegal/Politicadeprivacidad",
        "destination": "/Politicadeprivacidad",
        "type": 301
      },
      {
        "source": "/sitiolegal/Transparenciayprivacidad",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/sitiolegal",
        "destination": "/",
        "type": 301
      },
      {
        "source": "/Terminosdeuso.html",
        "destination": "/Terminosdeuso",
        "type": 301
      },
      {
        "source": "/sitiolegal/Terminosdeuso.html",
        "destination": "/Terminosdeuso",
        "type": 301
      },
      {
        "source": "/sitiolegal/Terminosdeuso",
        "destination": "/Terminosdeuso",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/sitiolegal/Transparenciayprivacidad.html"
      },
      {
        "source": "/Transparenciayprivacidad",
        "destination": "/sitiolegal/Transparenciayprivacidad.html"
      },
      {
        "source": "/Politicadeprivacidad",
        "destination": "/sitiolegal/Politicadeprivacidad.html"
      },
      {
        "source": "/Eliminarcuenta",
        "destination": "/sitiolegal/Eliminarcuenta.html"
      },
      {
        "source": "/Terminosdeuso",
        "destination": "/sitiolegal/Terminosdeuso.html"
      },
      {
        "source": "/terminos-de-uso",
        "destination": "/sitiolegal/Terminosdeuso.html"
      },
      {
        "source": "/politica-de-privacidad",
        "destination": "/sitiolegal/Politicadeprivacidad.html"
      },
      {
        "source": "/eliminar-cuenta",
        "destination": "/sitiolegal/Eliminarcuenta.html"
      },
      {
        "source": "/Restablecercontrasena",
        "destination": "/siterecuperacion/index.html"
      },
      {
        "source": "/Correoconfirmado",
        "destination": "/siterecuperacion/Correoconfirmado.html"
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://tbliwiawziexlziqqcji.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(Politicadeprivacidad|Eliminarcuenta|Terminosdeuso|Transparenciayprivacidad|Restablecercontrasena|Correoconfirmado)*",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/@(sitiolegal|siterecuperacion)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  }
}
